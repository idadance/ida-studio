generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Studio {
  id           String        @id @default(cuid())
  name         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  code         String?       @unique
  performances Performance[] @relation("PerformanceToStudio")
}

model Performance {
  id                         String            @id @default(cuid())
  name                       String
  description                String?
  coverImage                 String?
  status                     PerformanceStatus @default(DRAFT)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  driveCustomersFolderId     String?
  driveFolderId              String?
  driveVideosFolderId        String?
  fwCheckVideoVariantId      String?
  fwCreditVideoVariantId     String?
  pmCheckVideoVariantId      String?
  pmCreditVideoVariantId     String?
  rosterSheetGid             String?
  extraTicketRequestsEnabled Boolean           @default(false)
  programUrl                 String?
  reservations               Reservation[]
  shows                      Show[]
  orders                     TicketOrder[]
  studios                    Studio[]          @relation("PerformanceToStudio")
}

model Show {
  id                           String             @id @default(cuid())
  name                         String
  date                         DateTime?
  capacity                     Int                @default(250)
  performanceId                String
  shopifyCheckTicketVariantId  String?
  shopifyCreditTicketVariantId String?
  shopifyCheckVideoVariantId   String?
  shopifyCreditVideoVariantId  String?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  fwCheckTicketVariantId       String?
  fwCreditTicketVariantId      String?
  pmCheckTicketVariantId       String?
  pmCreditTicketVariantId      String?
  checkInOpen                  Boolean            @default(false)
  boxOffice                    BoxOfficeSettings?
  performance                  Performance        @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  ticketOrders                 TicketOrder[]
  waitlistEntries              WaitlistEntry[]
}

model BoxOfficeSettings {
  id                   String   @id @default(cuid())
  ticketPrice          Float    @default(15.00)
  digitalVideo         Boolean  @default(false)
  digitalVideoPrice    Float    @default(15.00)
  creditCardFeePercent Float    @default(2.6)
  creditCardEnabled    Boolean  @default(true)
  checkEnabled         Boolean  @default(true)
  ticketLimitEnabled   Boolean  @default(false)
  ticketLimit          Int      @default(4)
  salesOpen            Boolean  @default(false)
  showId               String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  show                 Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
}

model Reservation {
  id                   String              @id @default(cuid())
  customerName         String
  customerEmail        String
  paymentMethod        TicketPaymentMethod
  status               ReservationStatus   @default(PENDING)
  digitalVideo         Boolean             @default(false)
  totalAmount          Float               @default(0)
  shopifyOrderId       String?
  shopifyOrderNumber   String?
  performanceId        String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  driveFolderId        String?
  driveFolderLink      String?
  checkNumber          String?
  checkReceivedAt      DateTime?
  depositedAt          DateTime?
  notes                String?
  ticketsSentAt        DateTime?
  account              String?
  digitalVideoPaid     Boolean             @default(false)
  extraTicketRequestId String?             @unique
  performance          Performance         @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  ticketOrders         TicketOrder[]

  @@index([customerEmail])
  @@index([status])
  @@index([shopifyOrderId])
}

model TicketOrder {
  id                 String              @id @default(cuid())
  customerName       String
  customerEmail      String
  quantity           Int
  digitalVideo       Boolean             @default(false)
  paymentMethod      TicketPaymentMethod
  status             TicketOrderStatus   @default(PENDING)
  ticketSubtotal     Float               @default(0)
  videoSubtotal      Float               @default(0)
  totalAmount        Float               @default(0)
  shopifyOrderId     String?
  shopifyOrderNumber String?
  checkedInCount     Int                 @default(0)
  reservationId      String?
  showId             String
  performanceId      String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ticketCode         String?             @unique
  checkReceivedAt    DateTime?
  checkNumber        String?
  performance        Performance         @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  reservation        Reservation?        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  show               Show                @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([showId])
  @@index([performanceId])
  @@index([customerEmail])
  @@index([status])
  @@index([shopifyOrderId])
  @@index([reservationId])
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  customerName   String
  customerEmail  String
  customerPhone  String?
  account        String
  quantity       Int
  status         WaitlistStatus @default(WAITING)
  showId         String
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  claimedAt      DateTime?
  declinedAt     DateTime?
  cancelledAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  requestedAt    DateTime       @default(now())
  type           WaitlistType   @default(SOLD_OUT)
  show           Show           @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([showId])
  @@index([status])
  @@index([customerEmail])
  @@index([account])
  @@index([requestedAt])
  @@index([createdAt])
}

enum PerformanceStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum TicketPaymentMethod {
  CREDIT_CARD
  CHECK
}

enum TicketOrderStatus {
  PENDING
  CONFIRMED
  CANCELED
  REFUNDED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  CLAIMED
  DECLINED
  EXPIRED
  CANCELLED
}

enum WaitlistType {
  SOLD_OUT
  EXTRA_TICKETS
}

model Teacher {
  id String @id @default(cuid())

  firstName String
  lastName  String?

  active Boolean @default(true)

  maxSoloDuets Int @default(10)

  availabilitySheetUrl String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Genre {
  id   String @id @default(cuid())
  name String @unique
}